# 계정 이름(userNN)으로 바꿔서 .env로 복사하세요
DATABASE_URL=postgresql:///userNN?host=/var/run/postgresql
# OpenRouter API 키 (백엔드 전용. VITE_로 시작하는 이름으로 넣지 마세요)
OPENROUTER_API_KEY=
# 기상청 API 키 (data.go.kr 일반 인증키 중 Decoding 키, 백엔드 전용)
KMA_API_KEY=
# 네이버 검색 API (developers.naver.com 애플리케이션의 Client ID/Secret, 백엔드 전용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Finnhub 시세 API 키 (finnhub.io, 백엔드 전용)
FINNHUB_API_KEY=
